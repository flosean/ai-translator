<Window x:Class="NextAITranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NextAITranslator"
        Title="NextAI 翻譯" Height="600" Width="500"
        MinHeight="380" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Microsoft JhengHei UI" FontSize="14"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:ContentMinimumHeightConverter x:Key="ContentMinimumHeight" />
        <local:CompactControlBarConverter x:Key="CompactControlBar" />
    </Window.Resources>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ScaleXform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <ScrollViewer x:Name="ContentScroll" Margin="14"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
            <Grid Height="{Binding ViewportHeight, ElementName=ContentScroll}">
                <Grid.MinHeight>
                    <MultiBinding Converter="{StaticResource ContentMinimumHeight}">
                        <Binding ElementName="TranslationControls" Path="ActualHeight" />
                        <Binding ElementName="FooterControls" Path="ActualHeight" />
                    </MultiBinding>
                </Grid.MinHeight>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="InputRow" Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="OutputRow" Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 輸入 -->
                <TextBox x:Name="InputBox" Grid.Row="0"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                <!-- 整條控制列同時是分隔把手：按住空白處上下拖曳，調整輸入/輸出的比例。
                     先宣告（墊在下層），控制元件蓋在上面所以照常可點。 -->
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" Focusable="False" ShowsPreview="False"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              DragCompleted="Splitter_DragCompleted" />

                <!-- 翻譯固定靠右；極窄時移到控制列下一行的右側。 -->
                <Grid x:Name="TranslationControls" Grid.Row="1" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=TranslationControls, Converter={StaticResource CompactControlBar}}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="翻譯成" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <Button x:Name="TraditionalChineseButton" Content="繁體中文" Tag="zh-Hant"
                                    Padding="12,7" Margin="0,2,6,2" Click="LanguageButton_Click" />
                            <Button x:Name="EnglishButton" Content="English" Tag="en"
                                    Padding="12,7" Margin="0,2,8,2" Click="LanguageButton_Click" />
                        </WrapPanel>

                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="語調" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <ComboBox x:Name="ToneBox" Width="128" Margin="0,2,8,2" SelectedValuePath="Tag"
                                      SelectionChanged="ToneBox_SelectionChanged">
                                <ComboBoxItem Content="默認（自然）" Tag="default" />
                                <ComboBoxItem Content="專業" Tag="professional" />
                                <ComboBoxItem Content="友善" Tag="friendly" />
                                <ComboBoxItem Content="正式" Tag="formal" />
                                <ComboBoxItem Content="口語" Tag="casual" />
                            </ComboBox>
                        </WrapPanel>

                        <Button x:Name="ClearButton" Content="清除" Margin="0,2,0,2" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButton}" Click="ClearButton_Click" />
                    </WrapPanel>
                    <Button x:Name="TranslateButton" Content="翻譯" Padding="26,7"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="TranslateButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Margin" Value="8,2,0,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=TranslationControls, Converter={StaticResource CompactControlBar}}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Margin" Value="0,6,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 輸出 -->
                <TextBox x:Name="OutputBox" Grid.Row="2"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                <!-- 設定、模型與複製共用一排；模型名稱過長時省略。 -->
                <Grid x:Name="FooterControls" Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SettingsButton" Grid.Column="0" Content="設定" Margin="0,2,8,2"
                            Style="{StaticResource SecondaryButton}" Click="SettingsButton_Click" />
                    <TextBlock x:Name="ModelLabel" Grid.Column="1" Margin="0,0,8,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SubtleBrush}" />
                    <Button x:Name="CopyButton" Grid.Column="2" Content="複製"
                            Style="{StaticResource SecondaryButton}" Margin="0,2,0,2"
                            Click="CopyButton_Click" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
