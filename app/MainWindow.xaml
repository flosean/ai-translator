<Window x:Class="NextAITranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextAI 翻譯" Height="600" Width="500"
        MinHeight="380" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Microsoft JhengHei UI" FontSize="14"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ScaleXform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="InputRow" Height="*" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="OutputRow" Height="*" MinHeight="80" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 輸入 -->
            <TextBox x:Name="InputBox" Grid.Row="0"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

            <!-- 整條控制列同時是分隔把手：按住空白處上下拖曳，調整輸入/輸出的比例。
                 先宣告（墊在下層），控制元件蓋在上面所以照常可點。 -->
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Focusable="False" ShowsPreview="False"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          DragCompleted="Splitter_DragCompleted" />

            <!-- 控制列：語言 + 語調 + 清除 -->
            <Grid Grid.Row="1" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="翻譯成" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource SubtleBrush}" />
                    <ComboBox x:Name="TargetLang" Width="128" SelectedValuePath="Tag">
                        <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                        <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="日本語" Tag="ja" />
                        <ComboBoxItem Content="한국어" Tag="ko" />
                        <ComboBoxItem Content="Français" Tag="fr" />
                        <ComboBoxItem Content="Deutsch" Tag="de" />
                        <ComboBoxItem Content="Español" Tag="es" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="語調" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource SubtleBrush}" />
                    <ComboBox x:Name="ToneBox" Width="128" SelectedValuePath="Tag"
                              SelectionChanged="ToneBox_SelectionChanged">
                        <ComboBoxItem Content="默認（自然）" Tag="default" />
                        <ComboBoxItem Content="專業" Tag="professional" />
                        <ComboBoxItem Content="友善" Tag="friendly" />
                        <ComboBoxItem Content="正式" Tag="formal" />
                        <ComboBoxItem Content="口語" Tag="casual" />
                    </ComboBox>
                </StackPanel>

                <Button x:Name="ClearButton" Grid.Column="3" Content="清除"
                        Style="{StaticResource SecondaryButton}" Click="ClearButton_Click" />
            </Grid>

            <!-- 輸出 -->
            <TextBox x:Name="OutputBox" Grid.Row="2"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

            <!-- 底部：左 = 設定 + 目前模型；右 = 複製 + 翻譯 -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SettingsButton" Grid.Column="0" Content="設定"
                        Style="{StaticResource SecondaryButton}" Click="SettingsButton_Click" />
                <TextBlock x:Name="ModelLabel" Grid.Column="1" VerticalAlignment="Center"
                           Margin="12,0,8,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SubtleBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CopyButton" Content="複製"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="CopyButton_Click" />
                    <Button x:Name="TranslateButton" Content="翻譯"
                            Style="{StaticResource PrimaryButton}" Padding="26,7"
                            Click="TranslateButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
