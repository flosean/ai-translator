<Window x:Class="NextAITranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="500" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Microsoft JhengHei UI" FontSize="14"
        Background="{StaticResource BgBrush}" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="供應商" VerticalAlignment="Center" Margin="0,0,0,12"
                   Foreground="{StaticResource SubtleBrush}" />
        <ComboBox x:Name="ProviderBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"
                  SelectionChanged="ProviderBox_SelectionChanged">
            <ComboBoxItem Content="Gemini" Tag="gemini" />
            <ComboBoxItem Content="OpenAI（相容）" Tag="openai" />
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Margin="0,0,0,12"
                   Foreground="{StaticResource SubtleBrush}" />
        <TextBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                 LostFocus="ApiKeyBox_LostFocus" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,0,12"
                   Foreground="{StaticResource SubtleBrush}" />
        <TextBox x:Name="BaseUrlBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="模型" VerticalAlignment="Center" Margin="0,0,0,4"
                   Foreground="{StaticResource SubtleBrush}" />
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModelBox" Grid.Column="0" IsEditable="True" />
            <Button x:Name="RefreshButton" Grid.Column="1" Content="重新整理"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Click="RefreshButton_Click" />
        </Grid>
        <TextBlock x:Name="ModelStatus" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12"
                   FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"
                   Text="貼上 API Key 後會自動列出可用模型，或按「重新整理」。" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="全域熱鍵" VerticalAlignment="Center" Margin="0,0,0,4"
                   Foreground="{StaticResource SubtleBrush}" />
        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,12">
            <TextBox x:Name="HotkeyBox" />
            <TextBlock Text="格式範例：Ctrl+Alt+Z、Win+Shift+F5、Ctrl+1"
                       Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="介面縮放" VerticalAlignment="Center" Margin="0,0,0,12"
                   Foreground="{StaticResource SubtleBrush}" />
        <ComboBox x:Name="ScaleBox" Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                  Margin="0,0,0,12" SelectedValuePath="Tag">
            <ComboBoxItem Content="100%" Tag="1.0" />
            <ComboBoxItem Content="125%" Tag="1.25" />
            <ComboBoxItem Content="150%" Tag="1.5" />
            <ComboBoxItem Content="175%" Tag="1.75" />
            <ComboBoxItem Content="200%" Tag="2.0" />
        </ComboBox>

        <CheckBox x:Name="AutoTranslateBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,0"
                  Content="按熱鍵叫出視窗時，自動貼上剪貼簿並翻譯" />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="儲存" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
